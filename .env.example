APP_ENV=development
PORT=8080
AI_WORKER_PORT=8090
PADDLEOCR_SERVICE_PORT=8100
PADDLEOCR_SERVICE_URL=http://127.0.0.1:8100
PADDLEOCR_LANG=ch
PADDLEOCR_CPU_THREADS=4
PADDLEOCR_DISABLE_ONEDNN=true
AI_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-pro
AI_TIMEOUT_SECONDS=45

# Go API 使用的 OpenAI-compatible 三方 AI 配置，用于“AI 生成答题卡”等同步生成能力。
# DeepSeek 示例：AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1, AI_PROVIDER_MODEL=deepseek-chat
# 通义千问示例：AI_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, AI_PROVIDER_MODEL=qwen-plus
AI_PROVIDER_NAME=deepseek
AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=deepseek-chat
AI_PROVIDER_TIMEOUT_SECONDS=45

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=club

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

STORAGE_DRIVER=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=club
MINIO_SECRET_KEY=club_minio_pass
MINIO_BUCKET=club-dev
MINIO_USE_SSL=false

OBS_ENDPOINT=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_BUCKET=
OBS_REGION=
